  "extensionCount": 68,
  "finalAcceptanceBatch": "E6",
  "agentPolicy": "Single agent; no unrequested parallel delegation.",
  "testingPolicy": {
    "duringDevelopment": "Targeted behavior tests for changed mechanisms; static analysis as appropriate. No automatic full long matrix per patch.",
    "batchIntegration": "Full fast suite, applicable content validation, one final APK and a combined Android flow after code is stable.",
    "longRuns": "After major stable simulation integrations and final acceptance; keep and consume the current frozen run without restarting it for documentation, UI or asset-only changes.",
    "mandatoryFinal": "All agreed temporal, generational, narrative, recovery, 30-seed/200-year, active-millennium,32-settlement and Android criteria remain required."
  },
  "batches": [
    {
      "id": "E1",
      "name": "Experiencia inicial comprensible",
      "dependencies": [],
      "deliverables": [
        "Inicio centrado en habitantes, necesidades y una oportunidad real; observar, dirigir y delegar claramente diferenciados.",
        "Acciones contextuales con coste, requisitos, duración y consecuencia; retirar opciones sin utilidad inmediata del primer plano.",
        "Recorrido inicial de diez decisiones con capacidades actuales, sin ayudas invisibles; ampliar y repetir su aceptación en E5.",
        "Primera mejora visible de composición del asentamiento y selección táctil, con edificios y actividades confirmados."
      ],
      "modules": [
        "lib/presentation",
        "lib/session",
        "assets/art",
        "tool/generate_art.py"
      ],
      "closeWhen": [
        "Construir, avanzar, conocer otra comunidad, resolver una consecuencia y guardar/reabrir se entienden desde el flujo principal.",
        "APK intermedio con captura real; R11 completo permanece abierto hasta E5."
      ]
    },
    {
      "id": "E2",
      "name": "Sociedades, territorio y vidas personales",
      "dependencies": [
        "E1"
      ],
      "deliverables": [
        "Territorio real, acceso a rutas, instituciones, pactos, agravios, ocupación, guerra, secesión y continuidad tras perder la capital.",
        "Familias, genealogía conocida, relaciones adultas, separaciones, reconciliaciones, duelo, herencia y sucesión institucional.",
        "Viajes de familias/personajes y fundación de colonias con población y materiales en tránsito.",
        "Modelo final de identidades y contratos compartidos; conversiones explícitas, copia original y conservación de compromisos."
      ],
      "modules": [
        "lib/simulation",
        "lib/persistence",
        "lib/content",
        "lib/presentation"
      ],
      "closeWhen": [
        "Una decisión cambia el desarrollo de dos sociedades vivas; rutas cortadas, refugio y conflicto conservan personas y materiales.",
        "Cien años de continuidad familiar/política; las partidas existentes siguen recuperables."
      ]
    },
    {
      "id": "E3",
      "name": "Economía histórica, eras y especies",
      "dependencies": [
        "E2"
      ],
      "deliverables": [
        "Conservación material global, ocupaciones y capacidades territoriales; agua, alimento, vivienda, salud, mantenimiento y reparación completos.",
        "Seis eras operativas por asentamiento, coexistencia desigual, 180 días de soporte y 360 de pérdida, caminos alternativos y reconstrucción.",
        "Humanos y equinos jugables con anatomía, dieta, reproducción, longevidad, movilidad y herramientas propias; visitantes definidos para E4.",
        "30 construcciones/mejoras y 48 tecnologías funcionales; ambos orígenes y seis estrategias viables en contextos diferentes."
      ],
      "modules": [
        "lib/simulation",
        "lib/content",
        "content",
        "assets/content",
        "lib/presentation"
      ],
      "closeWhen": [
        "Las eras cambian cadenas productivas e instituciones; investigar no crea infraestructura o combustible.",
        "La especie modifica decisiones y viabilidad; diferencias y regresión demostradas mediante escenarios."
      ]
    },
    {
      "id": "E4",
      "name": "Director narrativo y acontecimientos extraordinarios",
      "dependencies": [
        "E2",
        "E3"
      ],
      "deliverables": [
        "Instancias con participantes vivos, lugar, causas, vencimiento, decisiones, consecuencias y memoria; exclusiones y cascadas acotadas.",
        "144 eventos independientes, 16 arcos con dos desenlaces mecánicos completos por arco y mínimos originales de plantillas/rasgos/perfiles conservados.",
        "Instalación antigua con una implementación declarativa y tres recorridos completos; ocho familias configurables por separado.",
        "Contacto, intercambio, infiltración, invasión, resistencia y convivencia extraterrestre; crisis locales, regionales y planetarias.",
        "Violencia con víctimas, refugiados, ruinas y responsabilidad; intimidad adulta por elipsis y ajustes independientes de sangre/cuerpos/texto."
      ],
      "modules": [
        "lib/simulation",
        "lib/content",
        "content",
        "assets/content",
        "lib/presentation"
      ],
      "closeWhen": [
        "Los desenlaces se alcanzan desde el inicio de cada cadena y cambian el mundo; no basta ejecutar efectos aislados.",
        "Desactivar una familia impide nuevos inicios y conserva consecuencias ya comprometidas; extinción no causa repoblación automática."
      ]
    },
    {
      "id": "E5",
      "name": "Historia, arte y experiencia Android completa",
      "dependencies": [
        "E1",
        "E2",
        "E3",
        "E4"
      ],
      "deliverables": [
        "Historial por bloques con causas, genealogía y fronteras comparables; saltos completos de uno/diez/cien años.",
        "Contenedor ZIP versionado y limitado, intercambio Android, contenido exacto por mundo y recuperación de interrupciones.",
        "Arte original por era/especie, actividades y recorridos locales válidos, daños y transformaciones, fuentes e inventarios.",
        "Primera sesión completa en ambos orígenes, guía opcional, accesibilidad, sonido/vibración y ajustes de presentación funcionales."
      ],
      "modules": [
        "lib/persistence",
        "lib/platform",
        "android",
        "lib/session",
        "lib/presentation",
        "assets/art",
        "tool"
      ],
      "closeWhen": [
        "Diez decisiones producen cambio visual persistente, consecuencia aplazada, interacción exterior y una opción desbloqueada por hechos.",
        "Guardado, selección, importación, suspensión y recuperación funcionan en Android; capturas reales permiten revisar la dirección visual."
      ]
    },
    {
      "id": "E6",
      "name": "Aceptación, rendimiento y entrega",
      "dependencies": [
        "E1",
        "E2",
        "E3",
        "E4",
        "E5"
      ],
      "deliverables": [
        "Matriz original y ampliación cerradas con evidencia; ninguna fila obligatoria pendiente o bloqueada se presenta como completa.",
        "Equivalencia temporal, mundo vivo, generaciones, cadenas, 30 semillas/200 años, milenios activos y escenarios de extinción diferenciados.",
        "32 asentamientos sostenidos, profile en Android de referencia y correcciones de problemas medidos.",
        "Fuente y generadores íntegros, inventario, paquete de ejemplo, documentación, dependencias fijadas, APK firmado para pruebas y SHA-256; instalación limpia/actualización/offline."
      ],
      "modules": [
        "docs",
        "test",
        "tool",
        "android",
        "build/deliverables"
      ],
      "closeWhen": [
